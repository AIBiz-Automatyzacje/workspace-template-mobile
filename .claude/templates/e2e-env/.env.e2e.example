# Srodowisko E2E dev-autopilot — DEDYKOWANY projekt Supabase (NIGDY dev ani prod!)
# Setup: .claude/templates/e2e-env/README.md
# Skopiuj ten plik do korzenia repo jako `.env.e2e` i uzupelnij wartosci.
# `.env.e2e` MUSI byc w .gitignore — env-up odmowi startu, jesli nie jest.

# Projekt e2e (Supabase dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://<ref-projektu-e2e>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key-projektu-e2e>

# Polaczenie do bazy e2e (Settings -> Database -> Connection string).
# UWAGA: tryb "direct" (db.<ref>.supabase.co) jest IPv6-only — w sieciach bez trasy IPv6
# nie zadziala. Bezpieczniejszy default: SESSION POOLER (IPv4, port 5432, wspiera migracje):
SUPABASE_E2E_DB_URL=postgresql://postgres.<ref-projektu-e2e>:<haslo-db>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Service role (Settings -> API) — tylko do tworzenia konta testowego przez admin API
SUPABASE_E2E_SERVICE_ROLE_KEY=<service-role-key-projektu-e2e>

# --- Konto testowe do logowania w flow Maestro ------------------------------
# Email+haslo, NIE OAuth (Maestro nie przejdzie sheetu Google/Apple). Konto MUSI istniec
# w projekcie e2e, a na tym projekcie MUSI byc wlaczony provider Email — inaczej logowanie
# haslem odpada i canary pada na loginie. Domena `.test` jest zarezerwowana na testy
# (RFC 6761): nie istnieje w globalnym DNS, wiec mail nie trafi do nikogo realnego.
# Podmien `<projekt>` — placeholder jest celowo niepoprawnym adresem, zeby zapomniana
# wartosc padla od razu, zamiast wygladac na dzialajaca.
#
# TA SAMA tozsamosc siedzi w tym pliku DWA razy i wartosci MUSZA byc IDENTYCZNE:
#   para E2E_TEST_*       -> dla HARNESSU: env-up loguje tym konto przez REST w canary, a
#                            `maestro test -e E2E_EMAIL=... -e E2E_PASSWORD=...` podaje je flow
#                            canary w wariancie z formularzem logowania.
#   para EXPO_PUBLIC_*    -> dla APKI (dwa klucze ponizej): swap `.env.local` w env-up przepisuje
#                            z tego pliku WYLACZNIE klucze `EXPO_PUBLIC_*`, a Expo inline'uje je
#                            do bundla.
# Bez pary EXPO_PUBLIC_* build nie zna konta testowego: ekranowy przycisk dev/E2E sign-in sie
# NIE renderuje i kazdy flow pada na pierwszym `tapOn`. Brak tej pary jest CICHY — z kluczy KONTA
# env-up wymaga wylacznie pary E2E_TEST_*, wiec setup „wg instrukcji" przechodzi bez ostrzezenia,
# a rozjazd wychodzi dopiero na pierwszej asercji za auth.
# Jesli seedy `.maestro/*-seed.sql` hardkoduja mail (`select id from auth.users where email=`),
# musi to byc TEN SAM mail — inaczej seed zatrzymuje sie, zeby nie pisac po cudzym koncie.
E2E_TEST_EMAIL=e2e@<projekt>.test
E2E_TEST_PASSWORD=<silne-haslo-testowe>
EXPO_PUBLIC_E2E_TEST_USER_EMAIL=e2e@<projekt>.test
EXPO_PUBLIC_E2E_TEST_USER_PASSWORD=<silne-haslo-testowe>
